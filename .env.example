# ==============================================================================
# Taste of Food - Environment Variables Configuration Template
# Copy this file to '.env' (or '.env.local') and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps (Web)
# NOTE: These are public web client credentials safe for frontend / Vercel deployment.
# Access control and data security are strictly enforced via firestore.rules and storage.rules.
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="default"

# ------------------------------------------------------------------------------
# 2. Payment Gateway Configuration (Optional - Razorpay UPI & Cards)
# Cash on Delivery (COD) is active by default and requires no external keys.
# To activate online UPI and card checkout, provide your Razorpay Public Key ID.
#
# CRITICAL SECURITY RULE:
# NEVER place your Razorpay Key Secret (RAZORPAY_KEY_SECRET) in frontend code
# or in this repository. Only the public Key ID is configured on the client.
# ------------------------------------------------------------------------------
VITE_RAZORPAY_KEY_ID="rzp_test_your_public_key_id"

# ------------------------------------------------------------------------------
# 3. Optional Platform Configuration
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"
APP_URL="https://your-deployment-domain.vercel.app"
