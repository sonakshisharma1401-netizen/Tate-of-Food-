rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'sonakshisharma1401@gmail.com' ||
        request.auth.token.email == 'sonakshisharma1099@gmail.com' ||
        request.auth.token.email == 'admin@tasteoffood.in'
      );
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|svg\\+xml)') &&
             request.resource.size <= 5 * 1024 * 1024; // Max 5MB
    }

    // Public food and menu item images
    match /food-images/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }

    match /products/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }

    match /catering-images/{imageId} {
      allow read: if true;
      allow create, update: if isAdmin() && isImage();
      allow delete: if isAdmin();
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
